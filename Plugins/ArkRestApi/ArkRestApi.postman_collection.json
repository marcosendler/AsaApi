		{
			"name": "Kick Player",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"steamName\": \"{{steamName}}\",\n  \"reason\": \"Kicked via REST API\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/players/kick",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "players", "kick"]

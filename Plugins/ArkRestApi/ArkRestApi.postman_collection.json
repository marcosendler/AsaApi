		{
			"name": "Spawn Dino",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"blueprint\": \"Blueprint'/Game/PrimalEarth/Dinos/Rex/Rex_Character_BP.Rex_Character_BP'\",\n  \"nearPlayer\": { \"steamName\": \"{{steamName}}\" },\n  \"level\": 30,\n  \"forceTame\": true,\n  \"neutered\": false\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/spawn/dino",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "spawn", "dino"]
				}
			},
			"response": [],
			"description": "Use `x`/`y`/`z` instead of `nearPlayer` to spawn at fixed coordinates."
		},
		{
			"name": "Spawn Dino As Cryopod",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"steamName\": \"{{steamName}}\",\n  \"blueprint\": \"Blueprint'/Game/PrimalEarth/Dinos/Argentavis/Argent_Character_BP.Argent_Character_BP'\",\n  \"level\": 150,\n  \"forceTame\": true,\n  \"neutered\": true,\n  \"gender\": \"male\",\n  \"saddleBlueprint\": \"Blueprint'/Game/PrimalEarth/CoreBlueprints/Items/Armor/Saddles/PrimalItemArmor_ArgentavisSaddle.PrimalItemArmor_ArgentavisSaddle_C'\",\n  \"saddleQuality\": 0\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/spawn/dino-cryopod",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "spawn", "dino-cryopod"]
				}
			},
			"response": [],
			"description": "Spawns the dino and immediately captures it into a cryopod delivered straight into the player's inventory. `gender` is optional (\"male\"/\"female\"). `saddleBlueprint` is strongly recommended - cryopod-ing erases the forceTame no-saddle-needed bypass, so without a real saddle equipped before capture the dino comes out with no inventory/riding access."
		},

				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"steamName\": \"{{steamName}}\",\n  \"durationMinutes\": 0\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/players/ban",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "players", "ban"]
				}
			},
			"response": [],
			"description": "durationMinutes: 0 = permanent ban."
		},

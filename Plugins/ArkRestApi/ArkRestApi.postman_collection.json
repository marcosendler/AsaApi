{
	"info": {
		"_postman_id": "b6f2a1d4-8e3c-4b7a-9c1d-4f5a6b7c8d9e",
		"name": "ArkRestApi",
		"description": "REST API exposed by the ArkRestApi AsaApi plugin. All routes except /health require a Bearer token (set the `bearerToken` collection variable).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{bearerToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8766",
			"type": "string"
		},
		{
			"key": "bearerToken",
			"value": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
			"type": "string"
		},
		{
			"key": "steamName",
			"value": "SomePlayer",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			}
		},

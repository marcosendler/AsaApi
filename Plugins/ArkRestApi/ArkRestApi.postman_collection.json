					"raw": "{{baseUrl}}/api/v1/players/notify",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "players", "notify"]
				}
			},
			"response": [],
			"description": "On-screen notification (harder to miss than a chat line)."
		},
		{

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Solution (Release|x64)",
            "type": "shell",
            "command": "D:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "AsaApi.sln",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/m",
                "/nologo",
                "/v:minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build ArkRestApi only",
            "type": "shell",
            "command": "D:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "Plugins/ArkRestApi/ArkRestApi.vcxproj",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/p:SolutionDir=${workspaceFolder}\\",
                "/m",
                "/nologo",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean Solution",
            "type": "shell",
            "command": "D:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "AsaApi.sln",
                "/t:Clean",
                "/p:Configuration=Release",
                "/p:Platform=x64"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
